---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getProfile } from '../lib/content';

const p = (await getProfile()).data;
const fileName = p.cvFile.split('/').pop();
---

<Base title="CV" description="Download the curriculum vitae (PDF) of Riaz Hussain, PhD — MRI physicist and research scientist.">
  <div class="container page">
    <h1>Curriculum vitae</h1>
    <p class="page-intro">
      My full CV as a PDF{p.cvUpdated && <> (last updated {p.cvUpdated})</>}. The{' '}
      <a href="/about/">About</a>, <a href="/publications/">Publications</a> and{' '}
      <a href="/skills/">Skills</a> pages summarise the same information.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href={p.cvFile} download={fileName}><Icon name="download" />Download CV (PDF)</a>
      <a class="btn" href={p.cvFile} target="_blank" rel="noopener"><Icon name="external" />Open in browser</a>
    </div>
    <div class="viewer">
      <object data={p.cvFile} type="application/pdf" title="CV of Riaz Hussain (PDF)">
        <p class="muted">Your browser cannot display the PDF here — use the download button above.</p>
      </object>
    </div>
  </div>
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }
  .viewer {
    display: none;
  }
  @media (min-width: 860px) {
    .viewer {
      display: block;
    }
    .viewer object {
      width: 100%;
      height: 80vh;
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }
  }
</style>
