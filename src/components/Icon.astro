---
// Small inline SVG icon set (no external requests).
interface Props {
  name:
    | 'linkedin'
    | 'scholar'
    | 'orcid'
    | 'github'
    | 'email'
    | 'download'
    | 'file'
    | 'external'
    | 'sun'
    | 'moon'
    | 'menu';
  label?: string;
}
const { name, label } = Astro.props;
const a11y: astroHTML.JSX.SVGAttributes = label
  ? { role: 'img', 'aria-label': label }
  : { 'aria-hidden': 'true' };
---

{name === 'linkedin' && (
  <svg viewBox="0 0 24 24" {...a11y}><rect x="2" y="2" width="20" height="20" rx="4" fill="currentColor"/><path d="M7 10v7M7 7v.01M11 17v-7m0 3a3 3 0 0 1 6 0v4" style="stroke: var(--bg)" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
)}
{name === 'scholar' && (
  <svg viewBox="0 0 24 24" {...a11y}><path d="M12 3 1 9l11 6 9-4.9V17h2V9L12 3z" fill="currentColor"/><path d="M5 13.2V17c0 1.7 3.1 3 7 3s7-1.3 7-3v-3.8l-7 3.8-7-3.8z" fill="currentColor"/></svg>
)}
{name === 'orcid' && (
  <svg viewBox="0 0 24 24" {...a11y}><circle cx="12" cy="12" r="10" fill="currentColor"/><path d="M8 10v7M8 7v.01M11 7h2.5a5 5 0 0 1 0 10H11V7z" style="stroke: var(--bg)" stroke-width="1.8" stroke-linecap="round" fill="none"/></svg>
)}
{name === 'github' && (
  <svg viewBox="0 0 16 16" {...a11y}><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
)}
{name === 'email' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" {...a11y}><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
)}
{name === 'download' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" {...a11y}><path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14"/></svg>
)}
{name === 'file' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" {...a11y}><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg>
)}
{name === 'external' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" {...a11y}><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
)}
{name === 'sun' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" {...a11y}><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
)}
{name === 'moon' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" {...a11y}><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
)}
{name === 'menu' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" {...a11y}><path d="M4 7h16M4 12h16M4 17h16"/></svg>
)}
